# ============================================================
# weather_bot — environment variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git or share it publicly.
# ============================================================

# ── OpenWeatherMap ──────────────────────────────────────────
# Get your free key at: https://home.openweathermap.org/api_keys
OWM_API_KEY=your_openweathermap_api_key_here

# ── Bitcoin Club Malta Weather — X (Twitter) ───────────────
# From: https://developer.twitter.com → your BCM app → Keys and Tokens
BCM_X_API_KEY=
BCM_X_API_SECRET=
BCM_X_ACCESS_TOKEN=
BCM_X_ACCESS_SECRET=

# ── Bitcoin Club Malta Weather — LinkedIn ──────────────────
# From: https://www.linkedin.com/developers → your BCM app
# BCM_LI_AUTHOR_URN format: urn:li:organization:YOUR_PAGE_ID
BCM_LI_ACCESS_TOKEN=
BCM_LI_AUTHOR_URN=urn:li:organization:YOUR_BCM_PAGE_ID

# ── Roatan Weather Bot — X (Twitter) ──────────────────────
# From: https://developer.twitter.com → your Roatan app → Keys and Tokens
ROA_X_API_KEY=
ROA_X_API_SECRET=
ROA_X_ACCESS_TOKEN=
ROA_X_ACCESS_SECRET=

# ── Roatan Weather Bot — LinkedIn ─────────────────────────
# ROA_LI_AUTHOR_URN format: urn:li:organization:YOUR_PAGE_ID
ROA_LI_ACCESS_TOKEN=
ROA_LI_AUTHOR_URN=urn:li:organization:YOUR_ROATAN_PAGE_ID
